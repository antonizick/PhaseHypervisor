#!/usr/bin/env python3
"""Fake `notify-send` for PHX tests: appends its argv to $PHX_FAKE_NOTIFY_LOG, shows nothing."""

import json
import os
import sys

log = os.environ.get("PHX_FAKE_NOTIFY_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(sys.argv[1:]) + "\n")
